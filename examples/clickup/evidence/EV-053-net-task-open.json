{
  "action": "Click a card title: the task opens in Full screen (2026-10-16). Shapes only; host omitted; ID-like object keys shown as :key. The permissions object (about 260 boolean flags) is cut.",
  "calls_in_order": [
    "POST frontdoor-search.clickup-eu.com/graphql/gateway?q (x2)",
    "GET /data/v3/workspaces/:id/time_allocations?task_id",
    "GET /task-v3/experience/:id/tasks/:id/hiddenFields -> {fields:[]}",
    "GET /ai/v1/workspaces/:id/recentPrompts",
    "GET /task-v3/experience/:id/tasks/:id?fields[]&filterOmit&relatedTaskFields&taskRelationshipTypes (task detail)",
    "GET /templates/v2/taskTemplate?fields[]&paging&team_id",
    "GET /:id/access/:id/task/:id/requests?get_user",
    "POST /task-v3/core/:id/tasks/:id/commentIds {hasAssignee, includeThreaded, headers{...}} -> {ids[]}",
    "POST /task-v3/experience/:id/tasks/history?fields[] {cursor, includeCommentsContent, minimumCommentCount, includedFields[], taskId, reverse, limit} -> {ids[], fields[], comments{}, historyItemData{}, userMap{}}",
    "GET /task-v3/experience/:id/tasks/:id?calculateRollups&fields[]&filterOmit",
    "POST /:id/access/:id/task/acls/bulk?expand_groups&include_parents",
    "POST /:id/access/authz/:id/permissions/bulk"
  ],
