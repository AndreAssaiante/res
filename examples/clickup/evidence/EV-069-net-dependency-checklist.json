{
  "note": "Shapes from the task view, 2026-10-16. Host omitted.",
  "add blocked-by dependency": [
    { "call": "POST /tasks/v2/task", "request": { "task_ids": ["string"], "fields": ["string"], "include_default_permissions": "boolean" }, "response": { "tasks": ["task objects with parent_status"] } },
    { "call": "POST /scheduling/v1/dependency", "request": { "task_id": "string (the blocked task)", "depends_on": "string (the blocking task)" }, "response": { "task_ids": ["string"], "depends_on": "string", "type": "number", "lag_ms": "null", "date_created": "number<epoch-ms>" } }
  ],
  "Create checklist (one click creates it)": { "call": "POST /tasks/v1/task/:id/checklist", "request": { "name": "string (Checklist)", "id": "string (client id)", "orderindex": "number", "items": [], "resolved": "number", "unresolved": "number", "creator": "number", "date_created": "string", "encrypted": "boolean", "show_completed": "boolean", "task_id": "string" }, "response": { "checklist": { "id": "string<uuid>", "task_id": "string", "name": "string", "orderindex": "number", "show_completed": "boolean", "resolved": "number", "unresolved": "number", "items": [] } } },
  "rename checklist": { "call": "PUT /tasks/v1/checklist/:id", "request": { "name": "string" }, "response": { "checklist": { "id": "string<uuid>", "task_id": "string", "name": "string", "encrypted": "boolean", "date_created": "string<epoch-ms-string>", "orderindex": "number", "show_completed": "boolean", "creator": "number", "resolved": "number", "unresolved": "number", "items": [] } } },
  "add checklist item (x3)": { "call": "POST /tasks/v1/checklist/:id/checklistItem?return_updated", "request": { "items": [{ "assignee": "null", "group_assignee": "null", "orderindex": "number", "name": "string", "parent": "null", "children": [], "resolved": "boolean" }] }, "response": { "items": [{ "id": "string<uuid>", "name": "string", "orderindex": "number", "assignee": "null", "group_assignee": "null", "resolved": "boolean", "encrypted": "boolean", "parent": "null", "date_created": "string<epoch-ms-string>", "start_date": "null", "start_date_time": "boolean", "due_date": "null", "due_date_time": "boolean", "sent_due_date_notif": "null", "children": [] }] } }
}
